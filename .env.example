# ============================================================================
# AI 香氛短视频内容诊断 — 环境变量样例
# 复制本文件为 .env 后填入真实值（.env 不要提交到 git）
# 模型：Qwen DashScope（OpenAI 兼容模式）
# 端点：https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# ============================================================================

# 必填：DashScope 控制台申请的 API Key（sk- 开头）
QWEN_API_KEY=

# 默认值：DashScope OpenAI 兼容模式根 URL，一般无需修改
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名（按账号开通的为准，常用 qwen-plus / qwen-turbo / qwen-max）
QWEN_MODEL=qwen-plus

# 单次 HTTP 请求超时（秒）。小项目里建议 15-30，模型卡顿时直接走异常分支
QWEN_TIMEOUT=20